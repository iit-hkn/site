---
const today = new Date();
---

<footer>
	<p class="name">IEEE-HKN · Illinois Institute of Technology</p>
	<p>
		&copy; {today.getFullYear()} HKN @ Illinois Tech · <a href="https://hkn.ieee.org/">A Chapter of IEEE-Eta Kappa Nu</a>
	</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 3em;
		background: rgb(var(--black));
		border-top: 6px solid var(--accent);
		color: #bbb;
		text-align: center;
		font-size: 0.85em;
	}
	footer p {
		margin: 0.25em 0;
	}
	.name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.15em;
		color: #fff;
	}
	a {
		color: #fff;
	}
	a:hover {
		color: #fff;
		text-decoration-color: var(--accent);
	}
</style>

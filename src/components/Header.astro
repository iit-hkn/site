---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import hkn from '../assets/IEEEEtaKappaNuLogo-Horizontal.svg';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const homeHref = base || '/';
---

<header>
	<nav>
		<h2>
			<a href="/">
				<img src={hkn.src} alt="Eta Kappa Nu Crest">
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={homeHref}>Home</HeaderLink>
			<HeaderLink href={`${base}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${base}/about`}>About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: flex-start;
	}
	.internal-links {
		display: flex;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		margin-left: auto;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

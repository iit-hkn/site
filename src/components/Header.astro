---
import HeaderLink from './HeaderLink.astro';
import hkn from '../assets/IEEEEtaKappaNuLogo-Horizontal.svg';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const homeHref = base || '/';
---

<header>
	<nav>
		<a class="logo" href={homeHref}>
			<img src={hkn.src} alt="IEEE Eta Kappa Nuboom" />
		</a>
		<div class="internal-links">
			<HeaderLink href={homeHref}>Home</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #fff;
		border-top: 6px solid var(--accent);
		box-shadow: 0 1px 0 rgb(var(--gray-light));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		max-width: 1100px;
		margin: 0 auto;
		min-height: 4.5rem;
	}
	.logo {
		display: flex;
		align-items: center;
		padding: 0.75em 0;
	}
	.logo img {
		height: 2.75rem;
		width: auto;
		border-radius: 0;
	}
	.internal-links {
		display: flex;
		align-self: stretch;
	}
	.internal-links :global(a) {
		display: flex;
		align-items: center;
		padding: 0 0.85em;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom: 4px solid transparent;
		border-top: 4px solid transparent;
	}
	.internal-links :global(a:hover) {
		color: var(--accent);
	}
	.internal-links :global(a.active) {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	@media (max-width: 560px) {
		nav {
			flex-direction: column;
			gap: 0;
		}
		.internal-links :global(a) {
			padding: 0.75em 0.6em;
		}
	}
</style>
